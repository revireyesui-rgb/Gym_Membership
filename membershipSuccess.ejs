<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Membership Registered | ST.FITTER GYM</title>
    <link rel="icon" type="image/png" href="/images/logo.jpg">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: radial-gradient(circle at top right, rgba(230, 57, 70, 0.12), transparent 35%), #1a1a1a;
            color: #f5f5f5;
            font-family: Arial, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 25px;
        }

        .card {
            width: 100%;
            max-width: 480px;
            background: #232323;
            border: 1px solid #353535;
            border-top: 4px solid #e63946;
            border-radius: 6px;
            padding: 35px;
            text-align: center;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.35);
        }

        h1 {
            color: #fff;
            font-size: 22px;
            margin: 0 0 10px;
            letter-spacing: 1px;
        }

        h1 span {
            color: #e63946;
        }

        .check {
            font-size: 48px;
            margin: 10px 0;
        }

        p {
            color: #bbb;
            font-size: 14px;
            line-height: 1.6;
        }

        .details {
            text-align: left;
            background: #1a1a1a;
            border: 1px solid #353535;
            border-radius: 4px;
            padding: 16px;
            margin: 20px 0;
            font-size: 13px;
        }

        .details div {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px solid #2a2a2a;
        }

        .details div:last-child {
            border-bottom: none;
        }

        .details .k {
            color: #888;
        }

        .details .v {
            color: #fff;
            font-weight: 700;
        }

        .status {
            color: #ffcc00;
            font-weight: 700;
        }

        a.btn {
            display: inline-block;
            margin-top: 10px;
            padding: 12px 24px;
            background: #e63946;
            color: #fff;
            text-decoration: none;
            border-radius: 4px;
            font-weight: 700;
            letter-spacing: 1px;
            font-size: 13px;
        }

        a.btn:hover {
            background: #c92f3b;
        }
    </style>
</head>

<body>
    <div class="card">
        <div class="check">✅</div>
        <h1>ST.<span>FITTER</span> GYM</h1>
        <p>Your online membership registration was submitted successfully.</p>

        <div class="details">
            <div><span class="k">Member ID</span><span class="v">#<%= member.id %></span></div>
            <div><span class="k">Name</span><span class="v">
                    <%= member.firstname %>
                        <%= member.lastname %>
                </span></div>
            <div><span class="k">Plan</span><span class="v">
                    <%= member.plan %>
                </span></div>
            <div><span class="k">Payment Method</span><span class="v">
                    <%= member.payment_method %>
                </span></div>
            <div><span class="k">Reference No.</span><span class="v">
                    <%= member.reference_no || '—' %>
                </span></div>
            <div><span class="k">Payment Status</span><span class="v status">
                    <%= member.payment_status %>
                </span></div>
            <div><span class="k">Membership Status</span><span class="v status">
                    <%= member.member_status %>
                </span></div>
        </div>

        <p>Please wait for staff to verify your payment. You'll be notified once your membership is
            <strong>Active</strong>.</p>

        <a href="/userIndex" class="btn">Back to Home</a>
    </div>
</body>

</html>